<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Newsletter DS&IP | Organograma</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8f9fa; color: #111; }
        ::-webkit-scrollbar { width: 0px; background: transparent; }
    </style>
</head>
<body class="antialiased min-h-screen p-4 md:p-8">

    <div class="max-w-6xl mx-auto bg-white shadow-xl overflow-hidden rounded-sm border border-gray-200">

        <!-- Header -->
        <div class="bg-black text-white p-6 flex justify-between items-center border-b-4 border-[#E97132]">
            <div>
                <h1 class="text-3xl font-extrabold tracking-tighter uppercase">Checkpoint</h1>
                <h2 class="text-xl font-light text-gray-300 tracking-widest">DS<span class="text-[#E97132]">&</span>IP</h2>
            </div>
            <div class="text-right">
                <p class="text-sm font-bold text-gray-400 uppercase tracking-wider">Demand | Supply | Inventory</p>
                <p class="text-xs text-gray-500 mt-1">Estrutura Organizacional</p>
            </div>
        </div>

        <!-- Banner / Navegação -->
        <div class="bg-gray-900 text-white py-4 px-8 shadow-sm relative overflow-hidden flex items-center justify-between gap-4 flex-wrap">
            <h2 class="text-3xl font-black italic tracking-wide uppercase text-white">ORGANOGRAMA DS&IP</h2>
            <div class="flex gap-2 flex-wrap">
                <a href="index.html" class="inline-flex items-center border border-white text-white px-4 py-2 text-sm font-bold uppercase tracking-wider hover:bg-white hover:text-black transition-colors">← VOLTAR AO CHECKPOINT</a>
            </div>
        </div>

        <!-- Exibição da Imagem -->
        <div class="p-6 md:p-10 bg-gray-50 flex justify-center items-center">
            <img 
                src="organograma-dsip.png" 
                onerror="if (this.src.endsWith('.png')) { this.src='organograma-dsip.jpg'; } else if (this.src.endsWith('.jpg')) { this.src='organograma-dsip.jpeg'; } else if (this.src.endsWith('.jpeg')) { this.src='organograma-dsip.svg'; }" 
                alt="Organograma DS&IP" 
                class="max-w-full h-auto rounded-lg shadow-md border border-gray-200 object-contain"
            />
        </div>

        <!-- Footer -->
        <footer class="bg-black text-white py-6 text-center border-t-4 border-[#E97132]">
            <p class="text-sm font-light text-gray-400">Newsletter Confidencial | Uso Interno</p>
            <p class="text-xs text-[#E97132] font-bold mt-1 tracking-widest uppercase">Just Do It.</p>
        </footer>

    </div>

</body>
</html>
